# Auth (required in production)
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
CHAINLIT_AUTH_SECRET=replace-with-a-long-random-secret

# Chainlit persistence (PostgreSQL from chainlit-datalayer)
DATABASE_URL=postgresql://root:root@localhost:5432/postgres

# Azure Blob Storage for uploaded files (local dev via Azurite)
BUCKET_NAME=my-container
APP_AZURE_STORAGE_ACCOUNT=devstoreaccount1
APP_AZURE_STORAGE_ACCESS_KEY=
APP_AZURE_STORAGE_CONNECTION_STRING=

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2

# RAG settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=3
DATA_DIR=data
PROMPT_PATH=prompts/rag_prompt.yaml
